# Optional: leave empty to use the clearly labeled scripted demo.
# Keep secrets on the server. Never prefix API keys with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=3001
HOST=127.0.0.1
# Development UI origin. For npm start, set this to http://localhost:3001.
APP_ORIGIN=http://localhost:5173
# Enable only when serving through HTTPS.
COOKIE_SECURE=false
# DATABASE_PATH defaults to ./data/still.sqlite
